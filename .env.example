DATABASE_URL="postgresql://auth_user:auth_pass@localhost:5432/auth_service?schema=public"
PORT=3000

# Generate strong random secrets, e.g.: openssl rand -hex 32
JWT_ACCESS_SECRET="change_me_access_secret"

ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=7

# Must be a 64-character hex string (32 bytes), e.g.: openssl rand -hex 32
TOTP_ENCRYPTION_KEY="change_me_64_char_hex_string_______________________________"
TOTP_ISSUER="auth-service"

# Comma-separated list of allowed origins for CORS
CORS_ORIGIN="http://localhost:5173"

# Base URL used to build password-reset links (no real email is sent — see README)
APP_URL="http://localhost:5173"
